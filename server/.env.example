# PostgreSQL — sesuaikan dengan container Postgres-mu (satu container, banyak database).
# Buat database-nya dulu, contoh: docker exec <container> createdb -U <user> securelint
# HOST 127.0.0.1 (bukan localhost) kalau Postgres jalan di WSL2: forwarding WSL2 ke
# Windows hanya IPv4, "localhost" bisa resolve ke ::1 dan bikin error Prisma P1001.
DATABASE_URL="postgresql://<user>:<password>@127.0.0.1:5432/securelint?schema=public"

# Server
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# ── Provider AI ─────────────────────────────────────────────────────────────
# provider "openai" / "claude" dari request body akan memakai LLM asli BILA key
# diisi; kalau kosong atau error runtime → otomatis fallback ke mock scanner
# (dan session di DB mencatat provider "mock" — jujur).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
